module operator;
  reg[3:0] a;
  reg[3:0] b;
  reg gt;
  reg lt;
  reg gtoeq;
  reg ltoeq;
  
  reg eq;
  reg neq;
  reg ceq;
  reg nceq;
  
  reg[3:0] bnot;
  reg[3:0] band;
  reg[3:0] bor;
  reg[3:0] bxor;
  reg[3:0] bxnor;
  
  reg red_and;
  reg red_or;
  reg red_nor;
  reg red_nand;
  reg red_xor;
  reg red_xnor;
  initial
    begin
                                       //( RELATIONAL OPERATORS)  //
      a= 4'b1011;
      b= 4'b1101;
      gt = a>b;
      $display("the value of gt is %b",gt);
      lt = a<b;
      $display("the value of lt is %b",lt);
      gtoeq = a>=b;
      $display("the value of gtoeq is %b",gtoeq);
      ltoeq = a<=b;
      $display("the value of ltoeq is %b",ltoeq);
      
      a= 4'b101x;
      b= 4'b1011;
      gt = a>b;
      $display("the value of gt is %b",gt);
      lt = a<b;
      $display("the value of lt is %b",lt);
      gtoeq = a>=b;
      $display("the value of gtoeq is %b",gtoeq);
      ltoeq = a<=b;
      $display("the value of ltoeq is %b",ltoeq);

                                      // (EQUALITY OPERATORS)//
      
      a= 4'b101x;
      b= 4'b1101;
      eq = a==b;
      $display("the value of eq is %b",eq);
      neq = a!=b ;
      $display("the value of neq is %b",neq);
       ceq = a===b;                / CASE EQUALITY OPERATORS/
      $display("the value of ceq is %b",ceq);
      nceq = a!==b;                /CASE EQUALITY OPERATORS/
      $display("the value of nceq is %b",nceq);

                               //BITWISE OPERATORS//
      a= 4'b1011;
      b= 4'b1101;
      bnot = ~a;
      $display("the value of bnot is %b",bnot);
      band = a&b ;
      $display("the value of band is %b",band);
       bor = a|b;
      $display("the value of bor is %b",bor);
      bxor = a^b;
      $display("the value of bxor is %b",bxor);
      bxnor = a~^b;
      $display("the value of bxnor is %b",bxnor);
      
      a= 4'bx01x;
      b= 4'b110x;
      bnot = ~a;
      $display("the value of bnot is %b",bnot);
      band = a&b ;
      $display("the value of band is %b",band);
       bor = a|b;
      $display("the value of bor is %b",bor);
      bxor = a^b;
      $display("the value of bxor is %b",bxor);
      bxnor = a~^b;
      $display("the value of bxnor is %b",bxnor);
                             // REDUCTION OPERATORS//
      a= 4'b1011;
      red_and= &a;
      $display("the value of red_and is %b",red_and);
      red_or = |a ;
      $display("the value of red_or is %b",red_or);
       red_nand = ~&a;
      $display("the value of red_nand is %b",red_nand);
       red_nor = ~|a;
      $display("the value of red_nor is %b",red_nor);
      red_xor = ^a;
      $display("the value of red_xor is %b",red_xor);
      red_xnor = ~^a;
      $display("the value of red_xnor is %b",red_xnor);      
    end
endmodule

